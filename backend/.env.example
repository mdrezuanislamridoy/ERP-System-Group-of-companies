# Server Configuration
PORT=4000
NODE_ENV=development
API_PREFIX=api/v1
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# PostgreSQL Connection (Main & RLS-enabled)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/okobiz_erp?schema=public"

# Redis Cache & Queues
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Security & Tokens
JWT_ACCESS_SECRET="okobiz-super-secret-jwt-access-key-2026"
JWT_ACCESS_EXPIRATION="15m"
JWT_REFRESH_SECRET="okobiz-super-secret-jwt-refresh-key-2026"
JWT_REFRESH_EXPIRATION="7d"

# Group ERP System Settings
DEFAULT_GROUP_ID="grp-abc"
DEFAULT_CURRENCY="BDT"
ENFORCE_STRICT_SCOPE=true
